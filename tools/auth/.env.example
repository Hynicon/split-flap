# Copy to tools/auth/.env (git-ignored) and fill in. Never commit the real file.

# Device
SPLITFLAP_HOST=splitflap.local
# SPLITFLAP_ADMIN_KEY=   # optional; prompted for if unset

# Instagram API with Instagram Login (Meta app > Instagram > API setup with Instagram login)
IG_APP_ID=
IG_APP_SECRET=

# Facebook Login for the Page (Meta app > App settings > Basic)
FB_APP_ID=
FB_APP_SECRET=

# TikTok for Developers (Login Kit, Desktop platform, redirect http://127.0.0.1:8765/callback/)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
