# Copy to server/.env (git-ignored) and fill in.

# Password for the app's sign-in page. At least 8 characters; use a long one, it faces the internet.
APP_PASSWORD=

# The display's token. At least 16 characters, for example: openssl rand -hex 24
# Enter the same value on the display (setup portal, or Settings on the display's own page).
DEVICE_TOKEN=

# The hostname nginx-proxy should route to this container.
VIRTUAL_HOST=flap.example.com

# Only if you use acme-companion for certificates: normally the same as VIRTUAL_HOST.
LETSENCRYPT_HOST=

# The Docker network your nginx-proxy container is on (docker network ls).
PROXY_NETWORK=nginx-proxy
