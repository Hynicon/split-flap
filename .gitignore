# Build output
.pio/
.vscode/
__pycache__/
*.pyc

# Secrets — never commit
.env
secrets.h
*.local.*

# Read-only upstream reference clones
upstream/

# Printables STLs (license: check before redistributing)
hardware/stl/*
!hardware/stl/README.md
# The electronics tray is this project's own design (tools/make_electronics_mount.py)
!hardware/stl/ElectronicsTray/
hardware/stl/ElectronicsTray/*
!hardware/stl/ElectronicsTray/ElectronicsTray.stl
# Build guide 3D models and photos are made from upstream files (tools/make_guide_models.py, make_guide_images.py)
hardware/guide/models/
hardware/guide/img/
# Your own photos go in photos/ (committed) via tools/add_photos.py; the originals stay here
hardware/guide/photos-inbox/

# Portainer upload bundle (python server/make_bundle.py)
server/dist/

# App demo (python tools/make_demo.py), published with the guide
hardware/guide/demo/
